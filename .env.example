# Front-end configuration (public values only — never put secrets in VITE_* variables).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SITE_URL=https://chef-pro-bordeaux.fr
# Optional
VITE_SENTRY_DSN=
VITE_TURNSTILE_SITE_KEY=
# Set to true only on a Supabase Pro plan (image transformations): serves resized images.
VITE_SUPABASE_IMAGE_TRANSFORMS=false

# Edge-function secrets live in supabase/functions/.env (see supabase/functions/.env.example).
