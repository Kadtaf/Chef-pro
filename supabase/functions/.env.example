# Secrets for edge functions. Set them on the hosted project with:
#   supabase secrets set --env-file supabase/functions/.env
MISTRAL_API_KEY=
MISTRAL_IMAGE_AGENT_ID=
# MISTRAL_MODEL=mistral-large-latest
# Comma separated list of origins allowed to call the functions
ALLOWED_ORIGINS=https://chef-pro-bordeaux.fr,http://localhost:5173
AI_DAILY_LIMIT=50
PUBLIC_SUBMIT_LIMIT_PER_HOUR=5
# Optional: Cloudflare Turnstile (anti-spam). Leave empty to disable.
TURNSTILE_SECRET_KEY=
# Optional: e-mail notifications through Resend
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=
