# Secrets for edge functions. Set them on the hosted project with:
#   supabase secrets set --env-file supabase/functions/.env
# Studio IA — texte : Google Gemini (aistudio.google.com), images : Stability AI (platform.stability.ai)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
STABILITY_API_KEY=
# Comma separated list of origins allowed to call the functions
ALLOWED_ORIGINS=https://chef-pro-bordeaux.fr,http://localhost:5173
AI_DAILY_LIMIT=50
PUBLIC_SUBMIT_LIMIT_PER_HOUR=5
# Optional: Cloudflare Turnstile (anti-spam). Leave empty to disable.
TURNSTILE_SECRET_KEY=
# Optional: e-mail notifications through Resend
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=
# Newsletter "Les inspirations du Chef" (Brevo double opt-in)
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_DOI_TEMPLATE_ID=
BREVO_REDIRECT_URL=https://chef-pro-bordeaux.fr/newsletter/confirmee
