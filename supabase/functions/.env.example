# Secrets for edge functions. Set them on the hosted project with:
#   supabase secrets set --env-file supabase/functions/.env
# Studio IA — texte : Google Gemini (aistudio.google.com), images : Stability AI (platform.stability.ai)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# Secours texte n°1 — Groq (gratuit, Llama 3.3 70B) : console.groq.com → API Keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# Secours texte n°2 — Cloudflare Workers AI : mêmes CLOUDFLARE_ACCOUNT_ID / CLOUDFLARE_API_TOKEN que les photos
# CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Ordre des IA de rédaction (facultatif)
# TEXT_PROVIDERS=gemini,groq,cloudflare
# Photos : Stability en premier, puis bascule automatique sur les services gratuits configurés.
STABILITY_API_KEY=
# Secours n°1 — Cloudflare Workers AI (quota gratuit quotidien) : dash.cloudflare.com → AI → Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Secours n°2 — Hugging Face (petits crédits gratuits mensuels) : huggingface.co → Settings → Access Tokens
HUGGINGFACE_API_TOKEN=
# Ordre des services d'images (facultatif)
# IMAGE_PROVIDERS=stability,cloudflare,huggingface
# Comma separated list of origins allowed to call the functions
ALLOWED_ORIGINS=https://chef-pro-bordeaux.fr,http://localhost:5173
AI_DAILY_LIMIT=50
PUBLIC_SUBMIT_LIMIT_PER_HOUR=5
# Optional: Cloudflare Turnstile (anti-spam). Leave empty to disable.
TURNSTILE_SECRET_KEY=
# Optional: e-mail notifications through Resend
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=
# Newsletter "Les inspirations du Chef" (Brevo double opt-in)
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_DOI_TEMPLATE_ID=
BREVO_REDIRECT_URL=https://chef-pro-bordeaux.fr/newsletter/confirmee
